{
  "name": "ness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "user:create": "node scripts/user.ts create",
    "user:password": "node scripts/user.ts password",
    "user:disable": "node scripts/user.ts disable",
    "user:enable": "node scripts/user.ts enable",
    "customers:merge": "node scripts/merge-customers.ts",
    "verify": "npm run lint && npm run typecheck && node scripts/vitest.mjs run --maxWorkers=1",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
